#!/bin/sh
# Make the read-only /usr/deplibs (squashfs) writable on kernels without
# overlayfs support, using a bind mount of a writable copy on /usr/data.
# Place in /etc/init.d/S00deplibs and run at boot (start).

TARGET=/usr/deplibs
COPY=/usr/data/deplibs

case "$1" in
  start)
    if grep -q " $TARGET " /proc/mounts && ! grep -q " $TARGET .*squashfs" /proc/mounts; then
      echo "$TARGET already writable"
      exit 0
    fi
    if [ ! -d "$COPY" ]; then
      echo "copying $TARGET to $COPY (one time)"
      cp -a "$TARGET" "$COPY" || exit 1
    fi
    mount --bind "$COPY" "$TARGET"
    if [ $? -eq 0 ]; then
      echo "$TARGET bind-mounted writable from $COPY"
    else
      echo "failed to bind-mount $TARGET"
      exit 1
    fi
    ;;
  stop)
    umount "$TARGET" 2>/dev/null
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
exit 0
