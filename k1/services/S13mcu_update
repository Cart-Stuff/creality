#!/bin/sh

PROG=/usr/bin/mcu_util
VERSION_FILE=/usr/data/mcu.versions
LOG_FILE=/tmp/mcu_update.log
FW_ROOT_DIR=/usr/share/klipper/fw

# RISC-V K1 (CH32V nozzle/bed + X2600 IPC main MCU) flashes via cmd_iap, not
# mcu_util. Its firmware images live in fw/K1-RISCV and use the stock Creality
# names (klipper_nozzle_serial_app.bin / klipper_leveling_serial_app.bin).
RISCV_IAP=/usr/bin/cmd_iap
RISCV_FW_DIR=K1-RISCV

RET_SUCCESS=0
RET_TIMEOUT=1
RET_ERROR=2

# Detect the RISC-V K1 revision: cmd_iap exists and the RISC-V nozzle/bed
# serial devices are present. This is independent of the GD32 board ID.
is_riscv_k1() {
    [ -x "$RISCV_IAP" ] && [ -e /dev/ttyS3 ] && [ -e /dev/ttyS4 ] \
        && [ -d "$FW_ROOT_DIR/$RISCV_FW_DIR" ]
}

# Flash one RISC-V MCU through the IAP bootloader.
#   $1 = device type (0xA1 nozzle, 0xA3 leveling)
#   $2 = tty device
#   $3 = firmware image path
riscv_flash() {
    local dtype=$1 tty=$2 fw=$3
    [ -f "$fw" ] || { write_log "riscv: no image $fw"; return $RET_ERROR; }
    write_log "riscv: flashing $fw to $tty (type $dtype)"
    local output=$($RISCV_IAP --device "$tty" --baudrate 230400 \
        --dtype "$dtype" --upgrade --firmware "$fw" 2>&1)
    local ret=$?
    write_log "$output"
    if [ $ret -ne $RET_SUCCESS ]; then
        write_log "riscv: flash $tty failed ret=$ret"
    else
        write_log "riscv: flash $tty success"
    fi
    return $ret
}

# Update the RISC-V nozzle + bed MCUs if the packaged images differ from what
# is recorded. The stock bootloader always re-flashes on --upgrade, so we gate
# on a recorded checksum to avoid flashing on every boot.
riscv_update() {
    mkdir -p "$(dirname "$VERSION_FILE")"
    local noz_fw=$FW_ROOT_DIR/$RISCV_FW_DIR/klipper_nozzle_serial_app.bin
    local bed_fw=$FW_ROOT_DIR/$RISCV_FW_DIR/klipper_leveling_serial_app.bin

    local noz_sum= bed_sum=
    [ -f "$noz_fw" ] && noz_sum=$(md5sum "$noz_fw" | awk '{print $1}')
    [ -f "$bed_fw" ] && bed_sum=$(md5sum "$bed_fw" | awk '{print $1}')

    local old_noz= old_bed=
    [ -f "$VERSION_FILE.riscv" ] && . "$VERSION_FILE.riscv"
    old_noz=$RISCV_NOZ_MD5
    old_bed=$RISCV_BED_MD5

    if [ -n "$noz_sum" ] && [ "$noz_sum" != "$old_noz" ]; then
        if riscv_flash 0xA1 /dev/ttyS3 "$noz_fw"; then
            RISCV_NOZ_MD5=$noz_sum
        fi
    fi
    if [ -n "$bed_sum" ] && [ "$bed_sum" != "$old_bed" ]; then
        if riscv_flash 0xA3 /dev/ttyS4 "$bed_fw"; then
            RISCV_BED_MD5=$bed_sum
        fi
    fi

    {
        echo "RISCV_NOZ_MD5=${RISCV_NOZ_MD5:-$old_noz}"
        echo "RISCV_BED_MD5=${RISCV_BED_MD5:-$old_bed}"
    } > "$VERSION_FILE.riscv"
}

write_log() {
    [ -e $LOG_FILE ] || touch $LOG_FILE
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] $1" >> $LOG_FILE
}

mcu_handshake() {
    local tty_path=$1

    local output=$($PROG -i $tty_path -c)
    local ret=$?
    if [ $ret -ne $RET_SUCCESS ]; then
        write_log "$output"
        write_log "handshake $tty_path fail, ret=$ret"
    else
        write_log "handshake $tty_path success"
    fi

    echo $ret
}

get_version() {
    local tty_path=$1

    local version=$($PROG -i $tty_path -g)
    local ret=$?
    if [ $ret -ne $RET_SUCCESS ]; then
        write_log "$version"
        write_log "get_version $tty_path fail, ret=$ret"
        echo "unknown"
    else
        # not sure why, but if the MCU is not even connected mcu_util returns 0 exit code
        # so we need to have a hack to look for dodgy version string
        if echo "$version" | grep -q "usart_rec_Process"; then
          write_log "$version"
          write_log "get_version $tty_path fail"
          echo "unknown"
        else
          write_log "get_version $version"
          echo "$version"
        fi
    fi
}

compare_version() {
    local version=$1
    local fw_dir=$2

    # version example: mcu0_110_G32-mcu0_000_000
    local hw_version=$(echo $version | awk 'BEGIN{FS="-"} {print $1} END{}')
    local fw_version=$(echo $version | awk 'BEGIN{FS="-"} {print $2} END{}')

    local invalid_fw_version=false
    if [ "${fw_version:4:1}" != "_" ] || [ "${fw_version:8:1}" != "_" ]; then
        write_log "get invalid fw version"
        invalid_fw_version=true
    fi

    cd $fw_dir

    local ret_fw_bin=
    if [ $(ls "$hw_version"*.bin | wc -l) -eq 1 ]; then
        local fw_bin=$(ls "$hw_version"*.bin)
        local tmp=${fw_bin%.*}
        local orig_fw_version=${version:18:3}
        local target_fw_version=${tmp:18:3}
        if [ "$invalid_fw_version" = "true" ] || [ $target_fw_version -ne $orig_fw_version ]; then
            ret_fw_bin=$fw_dir/$fw_bin
            write_log "old version: $version, will update: $ret_fw_bin"
        fi
    else
        write_log "we should keep only one firmware file for $hw_version board!"
    fi

    echo "$ret_fw_bin"
}

startup_app() {
    local tty_path=$1
    
    local output=$($PROG -i $tty_path -s)
    local ret=$?
    if [ $ret -ne $RET_SUCCESS ]; then
        write_log "$output"
        write_log "startup $tty_path fail, ret=$ret"
    else
        write_log "startup app success"
    fi
    return $ret
}

fw_update() {
    local tty_path=$1
    local fw_path=$2

    local output=$($PROG -i $tty_path -u -f $fw_path)
    local ret=$?
    if [ $ret -ne $RET_SUCCESS ]; then
        write_log "$output"
        write_log "fw_update $tty_path fail, $fw_path, ret=$ret"
    else
        write_log "fw_update success"
    fi
    echo $ret
}

auto_update() {
    # RISC-V K1 revision: handle separately and return (no GD32 mcu_util path).
    if is_riscv_k1; then
        write_log "Detected RISC-V K1; using cmd_iap update path"
        riscv_update
        return $?
    fi

    local model=$(get_sn_mac.sh model)
    local board=$(get_sn_mac.sh board)

    local bed_serial=
    local mcu_serial=
    local noz_serial=

    local fw_dir=
    case $board in
        "CR4CU220812S10" | "CR4CU220812S11" | "CR4CU220812S12")
            bed_serial=/dev/ttyS9
            mcu_serial=/dev/ttyS7
            noz_serial=/dev/ttyS1

            # note we are adding mcu update support for Ender 3 V3 (F001)
            if [ "$model" = "CR-K1" ] || [ "$model" = "K1C" ] || [ "$model" = "K1 SE" ] || [ "$model" = "CR-K1 Max" ] || [  "$model" = "K1 Max SE" ]; then
                fw_dir=K1
                write_log "The directory selected for this hardware is: $fw_dir"
            elif [ "$model" = "F001" ] || [ "$model" = "F002" ]; then
                fw_dir=F001
            else
                write_log "The script is not intended for this printer model ($model)"
                exit 1
            fi
            ;;
        "NEBULA V1.0.0.1")
            # note we are adding mcu update support for Ender 5 Max (F004)
            if [ "$model" = "F005" ]; then
                mcu_serial=/dev/ttyS1
                fw_dir=F005
            elif [ "$model" = "F003" ]; then
                mcu_serial=/dev/ttyS1
                noz_serial=/dev/ttyS7
                fw_dir=F003
            elif [ "$model" = "F004" ]; then
                mcu_serial=/dev/ttyS1
                noz_serial=/dev/ttyS7
                bed_serial=/dev/ttyS6
                fw_dir=F004
            else
                write_log "The script is not intended for this printer model ($model)"
                exit 1
            fi
            ;;
        *)
            write_log "The script is not intended for this board ($board)"
            exit 1
    esac

    if [ "x$fw_dir" = "x" ] || [ ! -d $FW_ROOT_DIR/$fw_dir ]; then
        exit 1
    fi

     # For some reason you have to get all the handshakes first and then flash the firmware, otherwise there may be problems.

     # Handshaking
    local mcu_ready=false
    if [ -n "$mcu_serial" ] && [ -e $mcu_serial ]; then
       local ret=$(mcu_handshake $mcu_serial)
        if [ $ret -eq $RET_SUCCESS ]; then
            mcu_ready=true
            write_log "mcu ready"
        fi
    fi

    local bed_ready=false
    if [ -n "$bed_serial" ] && [ -e $bed_serial ]; then
        local ret=$(mcu_handshake $bed_serial)
        if [ $ret -eq $RET_SUCCESS ]; then
            bed_ready=true
            write_log "bed ready"
        fi
    fi

    local noz_ready=false
    if [ -n "$noz_serial" ] && [ -e $noz_serial ]; then
        local ret=$(mcu_handshake $noz_serial)
        if [ $ret -eq $RET_SUCCESS ]; then
            noz_ready=true
            write_log "noz ready"
        fi
    fi

    if [ -f $VERSION_FILE ]; then
      # only clear out the file if at least one mcu can be flashed
      if [ $mcu_ready = "true" ] || [ $noz_ready = "true" ]; then
        rm $VERSION_FILE
      fi
    fi

    # Flashing
    if [ $mcu_ready = "true" ]; then
        local mcu_version=$(get_version $mcu_serial)
        if [ $mcu_version != "unknown" ]; then
            write_log "mcu_version: $mcu_version"
            local fw_bin=$(compare_version $mcu_version $FW_ROOT_DIR/$fw_dir)
            if [ "x$fw_bin" != "x" ]; then
                local ret=$(fw_update $mcu_serial $fw_bin)
                if [ $ret -eq $RET_SUCCESS ]; then
                    tmp=$(basename $fw_bin)
                    mcu_version=${tmp%.bin}
                fi
            else
                startup_app $mcu_serial
            fi
        fi
        echo "mcu_version=$mcu_version" >> $VERSION_FILE
    fi

    if [ $bed_ready = "true" ]; then
        local bed_version=$(get_version $bed_serial)
        if [ $bed_version != "unknown" ]; then
            write_log "bed_version: $bed_version"
            local fw_bin=$(compare_version $bed_version $FW_ROOT_DIR/$fw_dir)
            if [ "x$fw_bin" != "x" ]; then
                local ret=$(fw_update $bed_serial $fw_bin)
                if [ $ret -eq $RET_SUCCESS ]; then
                    tmp=$(basename $fw_bin)
                    bed_version=${tmp%.bin}
                fi
            else
                startup_app $bed_serial
            fi
            echo "bed_version=$bed_version" >> $VERSION_FILE
        fi
    fi

    if [ $noz_ready = "true" ]; then
        local noz_version=$(get_version $noz_serial)
        if [ $noz_version != "unknown" ]; then
            write_log "noz_version: $noz_version"
            local fw_bin=$(compare_version $noz_version $FW_ROOT_DIR/$fw_dir)
            if [ "x$fw_bin" != "x" ]; then
                local ret=$(fw_update $noz_serial $fw_bin)
                if [ $ret -eq $RET_SUCCESS ]; then
                    tmp=$(basename $fw_bin)
                    noz_version=${tmp%.bin}
                fi
            else
                startup_app $noz_serial
            fi
        fi
        echo "noz_version=$noz_version" >> $VERSION_FILE
    fi
}

# mcu_util is only required for the GD32 path; the RISC-V path uses cmd_iap.
if ! is_riscv_k1; then
    [ -x $PROG ] || {
        echo "not found $PROG!"
        exit 1
    }
fi

case "$1" in
    start)
        auto_update
        ;;
    *)
        echo "Usage: $0 {start}"
        exit 1
esac

exit $?
